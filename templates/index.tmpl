          </div>
          <div class="header-text">
            <h1>Welcome to the Ory community</h1>
            <p>Join the Ory Community Slack - the #1 destination for community support, announcements and idea exchange for all things Ory.</p>
          </div>
        </header>

        <form id="invite" class="form" method="post" action="/invite/" novalidate>
          <p id="form-status" class="status" role="status" aria-live="polite"></p>

          <div class="fields">
            <div class="field">
              <label for="email">Email</label>
              <input id="email" class="input" name="email" type="email" autocomplete="email" placeholder="Enter your email" required autofocus>
              <span id="email-error" class="field-message" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="fname">First name</label>
              <input id="fname" class="input" name="fname" type="text" autocomplete="given-name" placeholder="Enter your first name" required>
              <span id="fname-error" class="field-message" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="lname">Last name</label>
              <input id="lname" class="input" name="lname" type="text" autocomplete="family-name" placeholder="Enter your last name" required>
              <span id="lname-error" class="field-message" aria-live="polite"></span>
            </div>
          </div>

          <div class="checkbox-field">
            <label class="checkbox">
              <span class="checkbox-box">
                <input id="coc" name="coc" type="checkbox" value="1" required>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M11.6464 5.14645C11.8417 4.95118 12.1583 4.95118 12.3536 5.14645C12.5338 5.32669 12.5477 5.6103 12.3951 5.80645L12.3536 5.85355L7.35355 10.8536C7.17331 11.0338 6.8897 11.0477 6.69355 10.8951L6.64645 10.8536L4.14645 8.35355C3.95118 8.15829 3.95118 7.84171 4.14645 7.64645C4.32669 7.4662 4.6103 7.45234 4.80645 7.60485L4.85355 7.64645L7 9.7925L11.6464 5.14645Z"/>
                </svg>
              </span>
              <span>I agree to the <a class="link" href="{{.CocUrl}}" target="_blank" rel="noopener">Code of conduct<span class="visually-hidden"> (opens in a new tab)</span></a></span>
            </label>
            <span id="coc-error" class="field-message" aria-live="polite"></span>
          </div>

          <button class="button" type="submit">
            <svg class="spinner" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden>
              <path d="M12 3C10.22 3 8.47991 3.52784 6.99987 4.51677C5.51983 5.50571 4.36628 6.91131 3.68509 8.55585C3.0039 10.2004 2.82567 12.01 3.17294 13.7558C3.5202 15.5016 4.37737 17.1053 5.63604 18.364C6.89472 19.6226 8.49836 20.4798 10.2442 20.8271C11.99 21.1743 13.7996 20.9961 15.4442 20.3149C17.0887 19.6337 18.4943 18.4802 19.4832 17.0001C20.4722 15.5201 21 13.78 21 12" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="button-label">Get my invite</span>
          </button>
        </form>
      </div>
    </main>
    <script src="/static/client-v3.js" defer></script>
